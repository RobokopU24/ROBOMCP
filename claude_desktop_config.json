{
  "mcpServers": {
      "neo4j-robokop": {
        "command": "uvx",
        "args": [ "mcp-neo4j-cypher@0.2.1" ],
        "env": {
          "NEO4J_URI": "bolt://robokopkg.renci.org:7687",
          "NEO4J_DATABASE": "neo4j"
        }
      },
      "roboFastMCP": {
        "command": "uv",
        "args": [
            "--directory",
            "/PATH/TO/YOUR/robokop_mcp_server.py/DIRECTORY",
            "run",
            "robokop_mcp_server.py"
        ]
    }
  }
}
